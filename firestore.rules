rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // ALL COLLECTIONS - SERVER ONLY
    // ============================================
    // All Firestore operations are handled via Firebase Admin SDK
    // on the server (Next.js server actions/components).
    // Admin SDK bypasses these rules entirely.
    // 
    // These rules deny ALL client-side access for maximum security.
    // If you need client-side access in the future, add specific
    // rules for those operations.
    // ============================================

    // Users collection - server only
    match /users/{userId} {
      allow read, write: if false;
    }

    // Matches collection - server only
    match /matches/{matchId} {
      allow read, write: if false;
    }

    // Daily puzzles collection - server only
    match /dailyPuzzles/{puzzleId} {
      allow read, write: if false;
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}